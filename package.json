{
	"name": "@unleash/proxy-client-svelte",
	"version": "1.0.0",
	"description": "Svelte interface for working with Unleash",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Unleash/unleash-svelte-sdk.git"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && pnpm run package",
		"preview": "vite preview",
		"package": "svelte-kit sync && svelte-package && publint --pack npm",
		"prepublishOnly": "pnpm run package",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test": "svelte-kit sync && vitest run",
		"test:package": "pnpm run package && node scripts/test-package.mjs"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"peerDependencies": {
		"svelte": "^5.55.7"
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^9.0.0",
		"@sveltejs/kit": "^3.4.0",
		"@sveltejs/package": "^3.0.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/node": "^22.0.0",
		"@typescript-eslint/eslint-plugin": "^8.73.0",
		"@typescript-eslint/parser": "^8.73.0",
		"eslint": "^8.57.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^2.46.1",
		"happy-dom": "^21.0.4",
		"prettier": "^3.10.1",
		"prettier-plugin-svelte": "^4.2.0",
		"publint": "^0.3.25",
		"svelte": "^5.57.1",
		"svelte-check": "^4.7.8",
		"typescript": "^6.0.3",
		"vite": "^8.3.8",
		"vitest": "^5.1.1"
	},
	"dependencies": {
		"unleash-proxy-client": "^3.8.3"
	},
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"type": "module",
	"packageManager": "pnpm@12.23.0",
	"license": "MIT"
}
